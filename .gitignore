# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# ---- Model weights ----
# Ignore all checkpoints by default; the released SPOTnet weight is force-added
# (see `git add -f weights/spotnet.pt`).
*.pth
*.pt
*.ckpt
!weights/spotnet.pt

# ---- Datasets & large media (never commit patient / licensed data) ----
dataset/
combined_videos_new/
inpainted_videos_new/
frames/
*.mp4
*.avi
*.mov

# ---- Experiment outputs ----
out_*/
runs/
synth_eval*/
results/
*.csv

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
