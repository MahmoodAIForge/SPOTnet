# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/
env/

# ---- Model weights ----
# Ignore stray checkpoints by default, but ship the small detector checkpoints in
# weights/ (the 0.77M DetUNet weights used in the paper, ~3 MB each).
*.pth
*.pt
*.ckpt
!weights/*.pt

# ---- Datasets & large media (never commit patient / licensed data) ----
dataset/
combined_videos_new/
inpainted_videos_new/
frames/
*.mp4
*.avi
*.mov

# ---- Experiment outputs ----
out_*/
runs/
synth_eval*/
results/
*.csv

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
